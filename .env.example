# =============================================================
# Environment variables — Evo Labs Product Reviews
#
# Local dev: `shopify app dev` injects the SHOPIFY_* values for you,
#            so a local .env only needs the Supabase pair.
# Production: every variable below must be set in your host's
#            dashboard. The app refuses to boot without the required
#            ones rather than failing later with a confusing error.
# =============================================================

# --- Required: Shopify -------------------------------------------------
# Partner Dashboard -> your app -> Overview -> Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Your production host. No trailing slash. Must NOT contain the string
# "shopify" -- that fails an automated pre-submission check.
SHOPIFY_APP_URL=https://reviews.your-domain.com

# --- Required: Supabase ------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only. Bypasses RLS. Never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Recommended: theme editor deep link -------------------------------
# The app embed's UUID, so the Overview page can deep-link merchants
# straight into the theme editor with the embed pre-selected.
# Find it after `npm run deploy`: Partner Dashboard -> your app ->
# Extensions -> Reviews Widget -> the UUID in the URL.
SHOPIFY_APP_EMBED_UUID=

# --- Recommended: support + legal identity -----------------------------
# Rendered on /support and /privacy. Shopify requires both pages to
# show a real, monitored contact -- placeholders are a rejection.
SUPPORT_EMAIL=support@your-domain.com
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=

# --- Optional ----------------------------------------------------------
# error | warn | info | debug   (default: info in production)
LOG_LEVEL=info

NODE_ENV=production
PORT=3000
