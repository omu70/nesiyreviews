{% comment %}
  ============================================================
  App block — Store reviews
  File: /extensions/reviews-widget/blocks/store-reviews.liquid

  A store-wide wall of reviews. By default it shows every approved
  review in the shop, whichever product it belongs to, with the
  product named on each card — drop it on the homepage, an About
  page, or anywhere else a section block fits.

  The "Only reviews about the store itself" option narrows it to
  reviews filed against no product at all. That was the original
  behaviour, and as a default it rendered an empty block on any shop
  that had never created one.

  Product pages are handled by the Product reviews block, or
  automatically by the app embed.
  ============================================================
{% endcomment %}

<link rel="stylesheet" href="{{ 'reviews.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'reviews.css' | asset_url }}"></noscript>

<div
  class="evo-rw"
  data-evo-reviews-block
  data-evo-mode="store"
  data-evo-scope="{{ block.settings.scope }}"
  data-evo-limit="{{ block.settings.count }}"
  style="--evo-rw-max: {{ block.settings.max_width }}px;"
  {{ block.shopify_attributes }}
>
  <div class="evo-rw__reserve" aria-hidden="true"></div>
</div>

<script src="{{ 'reviews.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Store reviews",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "scope",
      "label": "Which reviews to show",
      "info": "\u201cEvery review\u201d is a wall of all your approved reviews across every product.",
      "options": [
        { "value": "all", "label": "Every review in the store" },
        { "value": "unattached", "label": "Only reviews about the store itself" }
      ],
      "default": "all"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Reviews shown before “Load more”",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 12
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1600,
      "step": 100,
      "default": 1200,
      "unit": "px"
    }
  ]
}
{% endschema %}
