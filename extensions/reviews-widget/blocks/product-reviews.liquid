{% comment %}
  ============================================================
  App block — Product reviews
  File: /extensions/reviews-widget/blocks/product-reviews.liquid

  The full review section: average rating, the 5→1 star breakdown,
  filters, the review list with photo thumbnails, load-more, and the
  submission form.

  Placing this block turns off the app embed's automatic placement, so
  the section appears exactly where the merchant put it and never
  twice.

  The block is only a mount point. Reviews arrive from the signed app
  proxy, paged, so a product with four thousand reviews still sends ten
  down the wire.
  ============================================================
{% endcomment %}

<link rel="stylesheet" href="{{ 'reviews.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'reviews.css' | asset_url }}"></noscript>

<div
  class="evo-rw"
  data-evo-reviews-block
  data-evo-mode="product"
  data-evo-limit="{{ block.settings.initial_count }}"
  style="--evo-rw-max: {{ block.settings.max_width }}px;"
  {{ block.shopify_attributes }}
>
  {% comment %}
    Reserved space, so the page below does not jump when the reviews
    land. reviews.js replaces this the moment it has real content.
  {% endcomment %}
  <div class="evo-rw__reserve" aria-hidden="true"></div>
</div>

<script src="{{ 'reviews.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product reviews",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Moderation, colours, photo settings and the review form are configured inside the Reviews app."
    },
    {
      "type": "select",
      "id": "initial_count",
      "label": "Reviews shown before “Load more”",
      "info": "Leave on “Use app setting” to keep every product page in step with the number set in the app.",
      "options": [
        { "value": "0", "label": "Use app setting" },
        { "value": "5", "label": "5" },
        { "value": "10", "label": "10" },
        { "value": "20", "label": "20" },
        { "value": "50", "label": "50" }
      ],
      "default": "0"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1600,
      "step": 100,
      "default": 1200,
      "unit": "px"
    }
  ]
}
{% endschema %}
